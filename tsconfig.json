{
  "extends": "$app/tsconfig",
  "compilerOptions": { 
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,  
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true
  },
  "include": ["src", "vite.config.ts"]
}
